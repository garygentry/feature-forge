{
  "specsDir": "./specs",
  "docsDir": "./docs/architecture",
  "backlogDir": null,
  "gitCommitAfterStage": true,
  "commitPrefix": "forge",
  "autoVerify": true,
  "stack": "python",
  "typeCheckCommand": "ruff check scripts/ eval/",
  "testCommand": "bash scripts/validate.sh",
  "smokeCommand": "python3 scripts/forge-session.py doctor --json",
  "loopIterationMultiplier": 1.5,
  "contextWindowTokens": 1000000,
  "loopRunner": {
    "bin": "rauf-stable"
  }
}
